{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hate-agent",
  "version": "0.1.2",
  "identifier": "dev.hateagent.app",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../../apps/desktop",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../apps/desktop",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hate-agent",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQTRDMjVDQjQwM0U0QjUKUldTMTVBTzBYTUtrTzlRMmdzVTZDV0Jnclp3ZVEzd0h6b3ovV28vRnJobFRpRXVDS09BODlBL0gK",
      "endpoints": [
        "https://github.com/m240xi/hate-agent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
